# --- Secrets ---
# The original .env held a live Discord bot token, a Groq key, and a Hugging Face
# token; Gemini-Voice-Splitter/.env held three more. All rotated before publication.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
.netrc
credentials*
*secrets*.json

# --- Environments ---
venv/
voice_env/
timbre_env/
env/
.venv/

# --- Python artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Third-party binaries (hundreds of MB) ---
ffmpeg_full/
ffmpeg.zip
ffmpeg.7z
ffmpeg
ffmpeg.exe

# --- Voice model assets ---
# Trained weights derived from a real person's voice. Deliberately not published;
# see the note at the top of README.md.
*.pt
*.pth
*.index
model/
data/voice_models/
AliceVoiceExtraction/

# --- Vendored third-party repos (own licenses + .git histories) ---
Timbre/
Gemini-Voice-Splitter/

# --- Audio ---
*.wav
*.mp3
downloads/

# --- Runtime data: private logs, chat DB, caches, reddit snapshot ---
data/
logs/
# (`state/` is deliberately NOT ignored: it is the Redis shared-state source
#  package, not runtime data. A blanket `state/` ignore here silently dropped
#  the whole package from this publication and broke every module that
#  imports it -- keep it tracked.)

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

