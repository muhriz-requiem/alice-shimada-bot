# Copy this file to `.env` and fill in real values.
# Your actual `.env` is never committed/shared -- this file only
# documents what each variable does.

# =========================================================
# DISCORD
# =========================================================
DISCORD_TOKEN=your-discord-bot-token

# Comma-separated Discord user IDs allowed to use /admin-* commands.
OWNER_IDS=123456789012345678

# Optional: a guild ID for instant slash-command sync during development.
# Leave unset for production (global sync, can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# =========================================================
# AI BACKEND
# =========================================================
# "shapes" = cloud inference via shapes.inc -- NOTE: Shapes.inc has
#            deprecated third-party build/API access as of mid-2026;
#            this backend will fail with an auth/404 error until they
#            restore it. Kept for a future one-line switch back.
# "groq"   = cloud inference via Groq's OpenAI-compatible API (no local
#            GPU/Ollama needed, fast, has a free tier). Current default.
# "ollama" = local inference via a running Ollama server
AI_BACKEND=groq

# --- Shapes.inc (only used if AI_BACKEND=shapes) ---
# Get these from https://shapes.inc after creating your Shape, if/when
# build access is available again.
SHAPESINC_API_KEY=your-shapes-api-key
SHAPESINC_SHAPE_USERNAME=your-shape-username
# Default rate limit is 5-20 requests/min depending on your plan.
SHAPES_RATE_LIMIT_RPM=20

# --- Groq (required if AI_BACKEND=groq) ---
# Get your key from https://console.groq.com/keys (free account, no
# credit card required for the free tier as of writing).
GROQ_API_KEY=your-groq-api-key
# See https://console.groq.com/docs/models for current model names.
# NOTE: llama-3.3-70b-versatile / llama-3.1-8b-instant moved to
# Enterprise-only; openai/gpt-oss-120b is the free-tier workhorse.
GROQ_MODEL=openai/gpt-oss-120b
# Free tier is generously rate-limited but not unlimited; raise this
# if you're on a paid plan with a higher requests-per-minute cap.
GROQ_RATE_LIMIT_RPM=30
# Tokens-per-minute budget (free tier for gpt-oss-120b is 8000). The
# client tracks a rolling 60s window of actual usage and holds or
# drops requests that would cross this instead of eating 429s.
GROQ_TPM_LIMIT=8000
# Longest the client will wait on a rate-limit backoff before giving
# up and returning the fallback (a voice reply arriving 20s late is
# worse than no reply).
GROQ_RETRY_MAX_WAIT=3.0
# Reasoning effort for gpt-oss models: low/medium/high (empty = off;
# only sent for openai/gpt-oss-* -- reasoning tokens spend from
# max_tokens, so "low" keeps short voice replies from coming back
# empty).
GROQ_REASONING_EFFORT=low

# --- Ollama (only used if AI_BACKEND=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# NOTE: OLLAMA_MODELS (where Ollama itself stores model files, e.g.
# D:\OllamaModels) is a system/service-level environment variable for
# the Ollama server, not something set here -- see README.md.

# --- Gemini (optional) ---
# Only used by the AliceVoiceExtraction one-off dataset tooling, never by
# the bot itself. Get a key from https://aistudio.google.com/apikey
# (free tier available) or Google Cloud Console > APIs & Services >
# Credentials for a Cloud API key.
GEMINI_API_KEY=

# =========================================================
# CHARACTER
# =========================================================
# Matches a folder name under character/data/
CHARACTER_NAME=alice

# When true, the full lore/identity/style-example prompt is built and
# sent on every request (used automatically when AI_BACKEND=ollama or
# AI_BACKEND=groq, since neither has a dashboard-configured personality
# of its own). When false, only a short per-user identity/relationship
# note is sent, since the personality lives on the Shapes.inc dashboard
# instead. Usually you don't need to set this -- it defaults based on
# AI_BACKEND.
INJECT_FULL_CHARACTER_PROMPT=

# =========================================================
# CONVERSATION BEHAVIOR
# =========================================================
CHAT_HISTORY_LENGTH=10
MEMORY_GRAPH_LIMIT=10
MEMORY_GRAPH_CAP_PER_USER=80
GIF_COOLDOWN_SECONDS=25

# Fallback reply when AI backend returns empty/error response.
FALLBACK_REPLY=I don't know what to say.

# =========================================================
# REDDIT
# =========================================================
# Reddit asks that you identify your app; include a contact method.
REDDIT_USER_AGENT=AliceShimadaBot/2.0 (Discord character bot; contact: your-reddit-username)
REDDIT_RAW_RETENTION_FILES=20
REDDIT_FETCH_PAGES=4
REDDIT_FETCH_INTERVAL_HOURS=12
REDDIT_FETCH_SORT=top
REDDIT_FETCH_TIME_RANGE=month
# Where fresh posts come from: pullpush (default, no-auth archive; Reddit
# 403s unauthenticated JSON and ended self-serve API apps Nov 2025) or
# reddit (legacy www.reddit.com listing API, kept for restored access).
REDDIT_SOURCE=pullpush

# =========================================================
# LOGGING
# =========================================================
LOG_LEVEL=INFO
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=3
LOG_JSON=false

# =========================================================
# HEALTH CHECK SERVER
# =========================================================
HEALTH_HOST=0.0.0.0                # server deploy; desktop daily driver: use 127.0.0.1 (don't expose :8080 on the LAN)
HEALTH_PORT=8080

# =========================================================
# SCREEN GLANCE ("Alice looks at my screen") - desktop companion
# =========================================================
# Alice glances at your screen and reacts in one in-character line.
# OFF by default; the tray's "Screen glances allowed" permission must
# ALSO be on before any capture (tray-permission mode). Screenshots
# live in RAM only, go to Groq's vision model (qwen; ~850 tokens per
# glance), and are discarded after the reply -- like your STT audio,
# this leaves the machine. Denylisted window titles are never captured
# or sent.
#   Voice:  "Alice, look at my screen" / "What's on my screen?"
#           "What do you think of THIS?" (she looks, then answers)
#   Tray:   "Look at my screen now" / "Screen glances allowed" (checkbox)
# The privacy gate is the tray checkbox (resets each boot — no capture
# while it is off); SCREEN_LOOK_ENABLED only makes the feature available.
SCREEN_LOOK_ENABLED=false
SCREEN_LOOK_MODEL=qwen/qwen3.8-27b          # current Groq vision model
SCREEN_LOOK_MAX_WIDTH=1280                  # downscale target (token budget)
SCREEN_LOOK_JPEG_QUALITY=70
SCREEN_LOOK_MONITOR=primary                 # primary | all | 0-based index
# Case-insensitive substrings: matching windows are refused, never sent.
SCREEN_LOOK_DENYLIST=bank,wallet,password,passwd,login,incognito,private,token,secret
SCREEN_LOOK_COOLDOWN_S=8                    # min seconds between triggered glances
SCREEN_LOOK_CONTEXT_TTL_S=300               # how long glance notes stay available for screen follow-ups
# Ambient glances: she comments on her own when the screen CHANGED and
# the conversation is idle. Every gate must pass (enabled + tray allowed
# + nothing playing + cooldown + hourly cap + min pixel change).
SCREEN_LOOK_AMBIENT=false
SCREEN_LOOK_AMBIENT_COOLDOWN_S=180
SCREEN_LOOK_AMBIENT_MAX_PER_HOUR=12
SCREEN_LOOK_MIN_CHANGE=0.04                 # fraction of pixels that must change
SCREEN_LOOK_MEMORY=true                     # store a short note in the memory graph
SCREEN_LOOK_EXPRESSION=happy                # MtBridge preset while commenting ("" = off)
SCREEN_LOOK_EXPRESSION_WEIGHT=0.5

# =========================================================
# MATEENGINE ALICE GUARD
# =========================================================
# AliceGuard.dll (Doorstop loader in the MateEngine folder) chain-loads
# MtBridge and disarms the Spine-bound hover region ("Intime Region")
# that plays the crotch-cover/embarrassed animation when the mouse
# passes near. Head and hand reactions keep working; window sitting is
# a separate system and unaffected.
#   disarm (default) | observe (log only) | off (original behavior)
# Revert fully: restore doorstop_config.ini from .alice_orig, delete
# AliceGuard.dll, restart MateEngineX. Log: MtBridge\guard.log.
ALICE_GUARD_MODE=disarm

# =========================================================
# REDIS (for horizontal scaling - optional)
# =========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =========================================================
# VOICE (v2.1 - optional)
# =========================================================
# Enable voice listening/speaking in Discord voice channels
VOICE_ENABLED=false

# STT (whisper = faster-whisper local; moonshine = fixed-language fast)
VOICE_STT_ENGINE=whisper
VOICE_STT_LANGUAGE=en          # en/ja = fixed, NO detection (saves time/resources); auto = detect via faster-whisper
VOICE_STT_MOONSHINE_EN=UsefulSensors/moonshine-base
VOICE_STT_MOONSHINE_JA=UsefulSensors/moonshine-tiny-ja
VOICE_STT_MODEL=medium         # whisper only: tiny/base/small/medium/large-v3-turbo

# STT models load from the local Hugging Face cache with zero hub
# traffic (set automatically by voice/stt.py). Uncomment to allow hub
# access, e.g. once to download a newly configured model.
# HF_HUB_OFFLINE=0
VOICE_STT_DEVICE=cuda          # cuda/cpu
VOICE_STT_COMPUTE_TYPE=int8_float16 # int8_float16 fits whisper-medium alongside GPT-SoVITS on 4GB

# STT eval capture: OFF. Re-enable (true) to collect clips for another
# engine comparison (manage.py eval-stt).
VOICE_STT_CAPTURE=false
# VOICE_STT_CAPTURE_LIMIT=200
# STT_EVAL_DIR=D:\AliceShimadaBot\stt_eval\clips

# TTS (edge = cloud fallback, sovits = local fine-tuned GPT-SoVITS)
VOICE_TTS_ENGINE=edge          # edge/sovits/rvc/piper
VOICE_TTS_VOICE=ja-JP-NanamiNeural
VOICE_TTS_RATE=-10%            # SSML rate for character feel
VOICE_TTS_PITCH=+5Hz

# GPT-SoVITS (VOICE_TTS_ENGINE=sovits) — server is auto-started if not listening
VOICE_SOVITS_URL=http://127.0.0.1:9880/tts
VOICE_SOVITS_REF_AUDIO=data/voice_models/alice_ref.wav
VOICE_SOVITS_TEXT_LANG=auto     # auto/ja/en
VOICE_SOVITS_TEMPERATURE=0.5
VOICE_SOVITS_TOP_P=0.8
VOICE_SOVITS_TOP_K=15
# Boot watchdog: while waiting for the port the bot tails the server's
# api_boot.log and echoes its newest line into the bot logs; when the
# log stops growing for STALL_TIMEOUT seconds the hung child is killed
# and the boot respawned (ATTEMPTS times, all inside STARTUP_TIMEOUT).
VOICE_SOVITS_STARTUP_TIMEOUT=420 # total seconds to wait for a cold boot before falling backVOICE_SOVITS_BOOT_STALL_TIMEOUT=180 # kill + respawn when boot log stops growing (0 = disable)
VOICE_SOVITS_BOOT_ATTEMPTS=2    # spawn cycles per startup budget
# Lazy-BERT patch (desktop/sovits_patch/apply.py): the Chinese BERT is
# ~1.35 GB fp32 on CUDA but only used for "zh" synthesis segments -- Alice
# speaks en/ja, which get zero tensors. The patch defers that load until a
# zh segment appears. Re-run the script after every GPT-SoVITS update; the
# server must be restarted to (un)apply.

# RVC (Voice Conversion) - Optional (used by the edge engine only)
VOICE_RVC_ENABLED=false
VOICE_RVC_MODEL_PATH=          # Path to .pth model (e.g. data/voice_models/alice_rvc.pth)
VOICE_RVC_INDEX_PATH=          # Path to .index file (e.g. data/voice_models/alice_rvc.index)
VOICE_RVC_PITCH=0              # Semitone shift
VOICE_RVC_DEVICE=cuda
VOICE_RVC_INDEX_RATE=0.75      # 0..1 FAISS index retrieval mix

# Diarization (pyannote)
VOICE_DIARIZATION=true
VOICE_HF_TOKEN=             # REQUIRED for pyannote models - get from https://huggingface.co/settings/tokens

# Audio
VOICE_SAMPLE_RATE=16000        # Internal (Whisper)
VOICE_DISCORD_SAMPLE_RATE=48000 # Discord Opus
VOICE_VAD_THRESHOLD=0.5
VOICE_MIN_SPEECH_DURATION=0.5
VOICE_MAX_SPEECH_DURATION=30.0

# Behavior
VOICE_CHANNEL_ID=              # Auto-join channel ID
VOICE_AUTO_JOIN=false
VOICE_REPLY_COOLDOWN=2.0       # Min seconds between replies
VOICE_MAX_TOKENS=400           # Completion cap for spoken replies (incl. gpt-oss reasoning tokens)
VOICE_REPLY_PROBABILITY=1.0    # 1.0 = always reply when addressed
VOICE_IGNORE_BOTS=true
VOICE_IGNORE_SELF=true

# Conversation-aware response decisioning
VOICE_RESPONSE_MODE=smart            # always/smart/mention_only/observer
VOICE_OWNER_PRIORITY=true            # Always respond to owner when the call is private
VOICE_SHARED_CALL_GOVERNOR=true      # If another human is in the call, only "alice, ..." gets a reply

# Name mention response - how Alice reacts when her name is mentioned
# but not directly addressed (e.g. "Alice is quiet" -> a short clarification
# instead of silence)
VOICE_NAME_MENTION_RESPONSE=soft  # soft (speak clarification) | skip (stay silent)

# Diarization mode - speaker analysis of clips (pyannote, ~1GB VRAM, non-blocking;
# useful in party channels with 2+ speakers)
VOICE_DIARIZE_MODE=none  # none | detect (metrics) | address (tentative phrases)

# Live voice mode (v2.4) - rebuilt interaction model for ChatGPT-voice-style
# responsiveness while keeping Groq + GPT-SoVITS (Alice's own timbre).
VOICE_LIVE_MODE=false                  # master switch (false = exact v2.3 behavior)
VOICE_SILENCE_THRESHOLD_PRIVATE=0.5    # adaptive turn-end on private calls (default 0.8 applies to shared)
VOICE_STT_PREDICTIVE_START=0.3         # start an early STT decode this far into the end-of-speech silence
VOICE_STT_PREDICTIVE_WAIT=0.35         # extra grace at the turn-end gate to collect an in-flight decode
VOICE_STREAM_GROQ=true                 # stream Groq replies (synthesize sentences while the model generates)
VOICE_SOVITS_STREAMING=false           # stream the first sentence through the SoVITS streaming API
VOICE_SOVITS_STREAM_MODE=1             # api_v2 streaming_mode for the streamed first sentence:
                                       #   1 = old fragment mode (best join quality, SLOWEST first audio)
                                       #   2 = chunked streaming, anti-repeat matrix kept (recommended)
                                       #   3 = fixed-length chunks, fastest, anti-repeat matrix disabled
                                       # Sentences after the first always use the high-quality batch path.
VOICE_ACK_ENABLED=true                 # banked "Hm?" acknowledgment while the reply generates
VOICE_ACK_MIN_DELAY=1.5                # predicted first-audio delay (s) needed to fire an ack
VOICE_ACK_COOLDOWN=15.0                # min seconds between address-acks
VOICE_BACKCHANNEL_BANK_SIZE=8          # prefetched ack/backchannel clips per language
VOICE_STT_HOSTED=false                 # transcribe via Groq's hosted Whisper instead of the local GPU engine.
                                       # Hosted is larger-model-accurate and frees ~1GB VRAM, but forfeits predictive
                                       # decode (pipeline skips it behind hosted) and sends mic audio to Groq;
                                       # on failure the local engine is still the fallback.
VOICE_STT_HOSTED_MODEL=whisper-large-v3-turbo
VOICE_STT_DECODE_TIMEOUT=60            # hard budget (s) for one local STT decode; a wedged CUDA decode releases the STT lock and the turn is dropped
VOICE_MIC_AGC=false                    # normalize faint mics toward VOICE_MIC_AGC_TARGET (fast attack, slow release, gain capped at MAX_GAIN)
VOICE_MIC_AGC_TARGET=0.12              # target mono RMS for AGC'd mic blocks
VOICE_MIC_AGC_MAX_GAIN=32              # AGC gain ceiling (x); never attenuates
VOICE_MIC_APM=false                    # WebRTC APM (aec-audio-processing pkg): Discord-class AEC+NS on the mic; echo-cancelled against Alice's own playback
VOICE_APM_DELAY_MS=60                  # estimated speaker->mic latency for the AEC; raise if echo survives
VOICE_TTS_PREROLL_MS=250               # hold playback start until this much audio is buffered (smooths streamed TTS jitter; +same TTFA)