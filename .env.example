# Copy this file to `.env` and fill in real values.
# Your actual `.env` is never committed/shared -- this file only
# documents what each variable does.

# =========================================================
# DISCORD
# =========================================================
DISCORD_TOKEN=your-discord-bot-token

# Comma-separated Discord user IDs allowed to use /admin-* commands.
OWNER_IDS=123456789012345678

# Optional: a guild ID for instant slash-command sync during development.
# Leave unset for production (global sync, can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# =========================================================
# AI BACKEND
# =========================================================
# "shapes" = cloud inference via shapes.inc -- NOTE: Shapes.inc has
#            deprecated third-party build/API access as of mid-2026;
#            this backend will fail with an auth/404 error until they
#            restore it. Kept for a future one-line switch back.
# "groq"   = cloud inference via Groq's OpenAI-compatible API (no local
#            GPU/Ollama needed, fast, has a free tier). Current default.
# "ollama" = local inference via a running Ollama server
AI_BACKEND=groq

# --- Shapes.inc (only used if AI_BACKEND=shapes) ---
# Get these from https://shapes.inc after creating your Shape, if/when
# build access is available again.
SHAPESINC_API_KEY=your-shapes-api-key
SHAPESINC_SHAPE_USERNAME=your-shape-username
# Default rate limit is 5-20 requests/min depending on your plan.
SHAPES_RATE_LIMIT_RPM=20

# --- Groq (required if AI_BACKEND=groq) ---
# Get your key from https://console.groq.com/keys (free account, no
# credit card required for the free tier as of writing).
GROQ_API_KEY=your-groq-api-key
# See https://console.groq.com/docs/models for current model names.
# NOTE: llama-3.3-70b-versatile / llama-3.1-8b-instant moved to
# Enterprise-only; openai/gpt-oss-120b is the free-tier workhorse.
GROQ_MODEL=openai/gpt-oss-120b
# Free tier is generously rate-limited but not unlimited; raise this
# if you're on a paid plan with a higher requests-per-minute cap.
GROQ_RATE_LIMIT_RPM=30
# Tokens-per-minute budget (free tier for gpt-oss-120b is 8000). The
# client tracks a rolling 60s window of actual usage and holds or
# drops requests that would cross this instead of eating 429s.
GROQ_TPM_LIMIT=8000
# Longest the client will wait on a rate-limit backoff before giving
# up and returning the fallback (a voice reply arriving 20s late is
# worse than no reply).
GROQ_RETRY_MAX_WAIT=3.0
# Reasoning effort for gpt-oss models: low/medium/high (empty = off;
# only sent for openai/gpt-oss-* -- reasoning tokens spend from
# max_tokens, so "low" keeps short voice replies from coming back
# empty).
GROQ_REASONING_EFFORT=low

# --- Ollama (only used if AI_BACKEND=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# NOTE: OLLAMA_MODELS (where Ollama itself stores model files, e.g.
# D:\OllamaModels) is a system/service-level environment variable for
# the Ollama server, not something set here -- see README.md.

# =========================================================
# CHARACTER
# =========================================================
# Matches a folder name under character/data/
CHARACTER_NAME=alice

# When true, the full lore/identity/style-example prompt is built and
# sent on every request (used automatically when AI_BACKEND=ollama or
# AI_BACKEND=groq, since neither has a dashboard-configured personality
# of its own). When false, only a short per-user identity/relationship
# note is sent, since the personality lives on the Shapes.inc dashboard
# instead. Usually you don't need to set this -- it defaults based on
# AI_BACKEND.
INJECT_FULL_CHARACTER_PROMPT=

# =========================================================
# CONVERSATION BEHAVIOR
# =========================================================
CHAT_HISTORY_LENGTH=10
MEMORY_GRAPH_LIMIT=10
MEMORY_GRAPH_CAP_PER_USER=80
GIF_COOLDOWN_SECONDS=25

# Fallback reply when AI backend returns empty/error response.
FALLBACK_REPLY=I don't know what to say.

# =========================================================
# REDDIT
# =========================================================
# Reddit asks that you identify your app; include a contact method.
REDDIT_USER_AGENT=AliceShimadaBot/2.0 (Discord character bot; contact: your-reddit-username)
REDDIT_RAW_RETENTION_FILES=20
REDDIT_FETCH_PAGES=4
REDDIT_FETCH_INTERVAL_HOURS=12
REDDIT_FETCH_SORT=top
REDDIT_FETCH_TIME_RANGE=month
# Where fresh posts come from: pullpush (default, no-auth archive; Reddit
# 403s unauthenticated JSON and ended self-serve API apps Nov 2025) or
# reddit (legacy www.reddit.com listing API, kept for restored access).
REDDIT_SOURCE=pullpush

# =========================================================
# LOGGING
# =========================================================
LOG_LEVEL=INFO
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=3
LOG_JSON=false

# =========================================================
# HEALTH CHECK SERVER
# =========================================================
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# =========================================================
# REDIS (for horizontal scaling - optional)
# =========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =========================================================
# VOICE (v2.1 - optional)
# =========================================================
# Enable voice listening/speaking in Discord voice channels
VOICE_ENABLED=false

# STT (whisper = faster-whisper local; moonshine = fixed-language fast)
VOICE_STT_ENGINE=whisper
VOICE_STT_LANGUAGE=en          # en/ja = fixed, NO detection (saves time/resources); auto = detect via faster-whisper
VOICE_STT_MOONSHINE_EN=UsefulSensors/moonshine-base
VOICE_STT_MOONSHINE_JA=UsefulSensors/moonshine-tiny-ja
VOICE_STT_MODEL=medium         # whisper only: tiny/base/small/medium/large-v3-turbo

# STT models load from the local Hugging Face cache with zero hub
# traffic (set automatically by voice/stt.py). Uncomment to allow hub
# access, e.g. once to download a newly configured model.
# HF_HUB_OFFLINE=0
VOICE_STT_DEVICE=cuda          # cuda/cpu
VOICE_STT_COMPUTE_TYPE=int8_float16 # int8_float16 fits whisper-medium alongside GPT-SoVITS on 4GB

# STT eval capture: OFF. Re-enable (true) to collect clips for another
# engine comparison (manage.py eval-stt).
VOICE_STT_CAPTURE=false
# VOICE_STT_CAPTURE_LIMIT=200
# STT_EVAL_DIR=D:\AliceShimadaBot\stt_eval\clips

# TTS (edge = cloud fallback, sovits = local fine-tuned GPT-SoVITS)
VOICE_TTS_ENGINE=edge          # edge/sovits/rvc/piper
VOICE_TTS_VOICE=ja-JP-NanamiNeural
VOICE_TTS_RATE=-10%            # SSML rate for character feel
VOICE_TTS_PITCH=+5Hz

# GPT-SoVITS (VOICE_TTS_ENGINE=sovits) — server is auto-started if not listening
VOICE_SOVITS_URL=http://127.0.0.1:9880/tts
VOICE_SOVITS_REF_AUDIO=data/voice_models/alice_ref.wav
VOICE_SOVITS_TEXT_LANG=auto     # auto/ja/en
VOICE_SOVITS_TEMPERATURE=0.5
VOICE_SOVITS_TOP_P=0.8
VOICE_SOVITS_TOP_K=15

# RVC (Voice Conversion) - Optional (used by the edge engine only)
VOICE_RVC_ENABLED=false
VOICE_RVC_MODEL_PATH=          # Path to .pth model (e.g. data/voice_models/alice_rvc.pth)
VOICE_RVC_INDEX_PATH=          # Path to .index file (e.g. data/voice_models/alice_rvc.index)
VOICE_RVC_PITCH=0              # Semitone shift
VOICE_RVC_DEVICE=cuda
VOICE_RVC_INDEX_RATE=0.75      # 0..1 FAISS index retrieval mix

# Diarization (pyannote)
VOICE_DIARIZATION=true
VOICE_HF_TOKEN=             # REQUIRED for pyannote models - get from https://huggingface.co/settings/tokens

# Audio
VOICE_SAMPLE_RATE=16000        # Internal (Whisper)
VOICE_DISCORD_SAMPLE_RATE=48000 # Discord Opus
VOICE_VAD_THRESHOLD=0.5
VOICE_MIN_SPEECH_DURATION=0.5
VOICE_MAX_SPEECH_DURATION=30.0

# Behavior
VOICE_CHANNEL_ID=              # Auto-join channel ID
VOICE_AUTO_JOIN=false
VOICE_REPLY_COOLDOWN=2.0       # Min seconds between replies
VOICE_MAX_TOKENS=400           # Completion cap for spoken replies (incl. gpt-oss reasoning tokens)
VOICE_REPLY_PROBABILITY=1.0    # 1.0 = always reply when addressed
VOICE_IGNORE_BOTS=true
VOICE_IGNORE_SELF=true

# Name mention response - how Alice reacts when her name is mentioned
# but not directly addressed (e.g. "Alice is quiet" -> a short clarification
# instead of silence)
VOICE_NAME_MENTION_RESPONSE=soft  # soft (speak clarification) | skip (stay silent)

# Diarization mode - speaker analysis of clips (pyannote, ~1GB VRAM, non-blocking;
# useful in party channels with 2+ speakers)
VOICE_DIARIZE_MODE=none  # none | detect (metrics) | address (tentative phrases)